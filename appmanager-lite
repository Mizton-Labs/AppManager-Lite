#!/usr/bin/env bash
#
# appmanager-lite — lifecycle manager for the AppManager Lite portal.
#
# Usage:
#   appmanager-lite install   (root/sudo required; installs uv + Node.js/npm)
#   appmanager-lite start   [--bind IP:PORT] [--base-prefix /path] [--dev] [--rebuild] [--reinstall]
#   appmanager-lite stop
#   appmanager-lite status
#   appmanager-lite restart [--bind IP:PORT] [--base-prefix /path]
#   appmanager-lite reset-admin-password
#   appmanager-lite --reset-admin-password
#
# The server runs locally by default (127.0.0.1:8000) and logs to logs/app.log.
# Use --dev to run in the foreground with auto-reload (Ctrl-C to stop). For
# deployment behind a reverse proxy that serves the app from a subpath, pass
# --base-prefix and bind to 0.0.0.0 (e.g. --bind 0.0.0.0:8000 --base-prefix /home).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
BACKEND_DIR="$PROJECT_DIR/backend"
FRONTEND_DIR="$PROJECT_DIR/frontend"
VENV_DIR="$BACKEND_DIR/.venv"
PID_DIR="$PROJECT_DIR/.pids"
LOG_DIR="$PROJECT_DIR/logs"
PID_FILE="$PID_DIR/server.pid"
LOG_FILE="$LOG_DIR/app.log"
# Runtime stamps (under the git-ignored .pids dir) used to detect, between
# starts, whether the checked-out code or the backend lockfile changed so the
# operator can be warned about updates that may need manual follow-up.
COMMIT_STAMP="$PID_DIR/last-run-commit"
UVLOCK_STAMP="$PID_DIR/last-run-uvlock"
FRONTEND_GIT_STAMP="$PID_DIR/last-frontend-git-state"

VENV_PY="$VENV_DIR/bin/python"

# Defaults (overridable via flags / environment).
BIND="${APP_BIND:-127.0.0.1:8000}"
BASE_PREFIX="${APP_BASE_PREFIX:-}"
FORCE_REBUILD=0
FORCE_REINSTALL=0
DEV_MODE=0

log()  { printf '[appmanager-lite] %s\n' "$*"; }
err()  { printf '[appmanager-lite] error: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Require a build/run prerequisite (uv or npm); on absence, point the operator
# at the root-only installer instead of a bare "not found".
require_prereq() {
  command -v "$1" >/dev/null 2>&1 && return 0
  err "required command not found: $1"
  die "install prerequisites with: sudo ./$(basename "$0") install"
}

# --- Prerequisite installer (root-only) ------------------------------------
#
# `install` installs the minimal prerequisites and is the ONLY operation that
# needs root: uv (via the official installer, into the *invoking* user's home)
# and Node.js/npm (via the OS package manager). The portal itself
# (start/stop/status/...) always runs as a normal user.

is_root() {
  [[ "${EUID:-$(id -u)}" -eq 0 ]]
}

# The unprivileged user that invoked sudo, or empty when run as a raw root
# login. uv installs per-user, so we need this to target the right home.
invoking_user() {
  local u="${SUDO_USER:-}"
  [[ -n "$u" && "$u" != "root" ]] && printf '%s\n' "$u"
}

# Echo the first supported package manager found, or empty.
detect_pkg_mgr() {
  local m
  for m in apt-get dnf yum pacman zypper apk; do
    if command -v "$m" >/dev/null 2>&1; then
      printf '%s\n' "$m"
      return 0
    fi
  done
  return 0
}

# Install OS packages non-interactively with the detected manager. Runs as the
# current (root) user; callers ensure we are root.
pkg_install() {
  local mgr="$1"; shift
  case "$mgr" in
    apt-get) apt-get update && apt-get install -y "$@" ;;
    dnf)     dnf install -y "$@" ;;
    yum)     yum install -y "$@" ;;
    pacman)  pacman -Sy --noconfirm "$@" ;;
    zypper)  zypper --non-interactive install "$@" ;;
    apk)     apk add "$@" ;;
    *)       die "unsupported package manager: '$mgr'" ;;
  esac
}

# Ensure curl is available (needed to fetch the uv installer).
ensure_curl() {
  local mgr="$1"
  command -v curl >/dev/null 2>&1 && return 0
  [[ -n "$mgr" ]] || die "curl is required but no supported package manager was found; install curl manually."
  log "installing curl ($mgr)"
  pkg_install "$mgr" curl
}

# Install uv for the invoking (non-root) user via the official installer.
# uv installs per-user into ~/.local/bin; we run the installer as that user so
# it lands in their home and is usable when they run start/stop as themselves.
install_uv() {
  local user="$1" home
  home="$(getent passwd "$user" | cut -d: -f6)"
  [[ -n "$home" ]] || die "could not resolve home directory for user '$user'"
  if sudo -u "$user" -H bash -lc 'command -v uv >/dev/null 2>&1'; then
    log "uv already installed for $user (skipping)"
    return 0
  fi
  log "installing uv for $user (curl | sh, into \$HOME/.local/bin)"
  sudo -u "$user" -H bash -lc 'curl -LsSf https://astral.sh/uv/install.sh | sh'
  if [[ -x "$home/.local/bin/uv" ]]; then
    log "uv installed at $home/.local/bin/uv"
    log "  ensure '\$HOME/.local/bin' is on PATH (the uv installer updates the shell profile)"
  else
    die "uv installation did not produce $home/.local/bin/uv"
  fi
}

# Install Node.js + npm system-wide via the OS package manager.
install_node_npm() {
  local mgr="$1"
  if command -v npm >/dev/null 2>&1; then
    log "npm already installed (skipping)"
    return 0
  fi
  [[ -n "$mgr" ]] || die "no supported package manager found; install Node.js and npm manually."
  log "installing Node.js and npm ($mgr)"
  pkg_install "$mgr" nodejs npm
  command -v npm >/dev/null 2>&1 || die "npm was not found after installation."
}

cmd_install() {
  if ! is_root; then
    err "the installer requires root."
    die "re-run as: sudo ./$(basename "$0") install"
  fi
  local user
  user="$(invoking_user)"
  if [[ -z "$user" ]]; then
    err "could not determine the unprivileged user to install uv for."
    die "run via sudo from your normal account: sudo ./$(basename "$0") install"
  fi
  local mgr
  mgr="$(detect_pkg_mgr)"
  if [[ -z "$mgr" ]]; then
    err "no supported package manager found (need one of: apt, dnf, yum, pacman, zypper, apk)."
    die "install Node.js + npm manually, and uv from https://docs.astral.sh/uv/"
  fi
  log "using package manager: $mgr; installing uv for user: $user"
  ensure_curl "$mgr"
  install_uv "$user"
  install_node_npm "$mgr"
  log "prerequisites ready."
  log "now run the portal as your normal user (not root):"
  log "    ./$(basename "$0") start"
}

# Current HEAD commit (short) of the repository the project lives in, or empty
# when git is unavailable or this is not a checkout. The .git directory may live
# above PROJECT_DIR, so resolve from PROJECT_DIR. Never fails the script.
git_head() {
  command -v git >/dev/null 2>&1 || return 0
  git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null || true
}

# Committer timestamp (epoch) of HEAD, or empty. Used to detect a build that is
# older than the current commit -- the About page bakes in the commit hash and
# contributor list at build time, so a newer HEAD means a stale frontend even
# when no source file changed.
git_head_timestamp() {
  command -v git >/dev/null 2>&1 || return 0
  git -C "$PROJECT_DIR" log -1 --format=%ct 2>/dev/null || true
}

# Exact Git state the frontend build is made from: the full HEAD object id and
# either the checked-out branch name or a fixed "(detached)" marker -- the
# About page bakes both the commit and branch into the build, so switching
# branches at the *same* commit (e.g. after a fast-forward merge) must still
# be treated as a build-input change even though no timestamp advances.
# Empty when git is unavailable or HEAD cannot be resolved (not a checkout).
git_frontend_state() {
  command -v git >/dev/null 2>&1 || return 0
  local commit branch
  commit="$(git -C "$PROJECT_DIR" rev-parse --verify --quiet HEAD 2>/dev/null || true)"
  [[ -n "$commit" ]] || return 0
  branch="$(git -C "$PROJECT_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  printf '%s %s\n' "$commit" "${branch:-(detached)}"
}

# mtime (epoch seconds) of a path, or 0 when absent.
mtime_of() {
  stat -c %Y "$1" 2>/dev/null || echo 0
}

# Backend Python dependencies are managed exclusively with uv (no pip/poetry).
# uv sync reconciles the venv to backend/uv.lock on every start, so a lockfile
# change from a pull is applied automatically here.
ensure_venv() {
  require_prereq uv
  if [[ "$FORCE_REINSTALL" -eq 1 ]]; then
    log "syncing backend dependencies (uv sync --reinstall)"
    ( cd "$BACKEND_DIR" && uv sync --reinstall )
  else
    # Note when the lockfile changed since the last start (informational; uv
    # sync below applies it regardless).
    if [[ -f "$UVLOCK_STAMP" && -f "$BACKEND_DIR/uv.lock" ]] \
       && ! cmp -s "$BACKEND_DIR/uv.lock" "$UVLOCK_STAMP"; then
      log "backend uv.lock changed since last start; uv sync will apply it"
    fi
    log "syncing backend dependencies (uv sync)"
    ( cd "$BACKEND_DIR" && uv sync )
  fi
  # Record the applied lockfile so the next start can detect a change.
  mkdir -p "$PID_DIR"
  [[ -f "$BACKEND_DIR/uv.lock" ]] && cp -f "$BACKEND_DIR/uv.lock" "$UVLOCK_STAMP" 2>/dev/null || true
}

# True (0) when frontend node_modules are missing or the lockfile/manifest is
# newer than npm's install marker, so dependencies need (re)installing.
frontend_deps_stale() {
  [[ -d "$FRONTEND_DIR/node_modules" ]] || return 0
  local marker
  marker="$FRONTEND_DIR/node_modules/.package-lock.json"
  [[ -f "$marker" ]] || return 0
  local marker_mtime lock_mtime pkg_mtime
  marker_mtime="$(mtime_of "$marker")"
  lock_mtime="$(mtime_of "$FRONTEND_DIR/package-lock.json")"
  pkg_mtime="$(mtime_of "$FRONTEND_DIR/package.json")"
  [[ "$lock_mtime" -gt "$marker_mtime" || "$pkg_mtime" -gt "$marker_mtime" ]]
}

# True (0) when the built frontend is missing or older than any build input.
# Inputs are the Vite sources/config AND the git HEAD commit/branch (baked
# into the About page at build time). Errs toward rebuilding when unknown.
frontend_is_stale() {
  local dist_index="$FRONTEND_DIR/dist/index.html"
  [[ -f "$dist_index" ]] || return 0

  local dist_mtime newest_src head_ts current_state stamped_state
  dist_mtime="$(mtime_of "$dist_index")"

  # Newest mtime across everything Vite consumes.
  newest_src="$(
    cd "$FRONTEND_DIR" 2>/dev/null && \
    find src public index.html package.json package-lock.json \
         vite.config.ts tsconfig.json -type f -printf '%T@\n' 2>/dev/null \
      | sort -nr | head -1 | cut -d. -f1
  )"
  [[ -n "$newest_src" && "$newest_src" -gt "$dist_mtime" ]] && return 0

  # A newer commit than the build stales the About page even with no file edit.
  head_ts="$(git_head_timestamp)"
  [[ -n "$head_ts" && "$head_ts" -gt "$dist_mtime" ]] && return 0

  # Switching to a different branch pointing at the *same* commit (e.g. after
  # a fast-forward merge) does not advance any timestamp above, but the About
  # page's baked-in branch would still be wrong -- compare the exact git state
  # the last successful build recorded.
  current_state="$(git_frontend_state)"
  if [[ -n "$current_state" ]]; then
    stamped_state="$(cat "$FRONTEND_GIT_STAMP" 2>/dev/null || true)"
    [[ "$current_state" != "$stamped_state" ]] && return 0
  fi

  return 1
}

# Record the git state (commit + branch) the frontend was just built from, so
# a later branch-only switch at the same commit is detected next time. Safe
# no-op outside a git checkout.
record_frontend_git_state() {
  local state
  state="$(git_frontend_state)"
  [[ -n "$state" ]] || return 0
  mkdir -p "$PID_DIR"
  printf '%s' "$state" >"$FRONTEND_GIT_STAMP" 2>/dev/null || true
}

ensure_frontend() {
  require_prereq npm
  if frontend_deps_stale; then
    log "installing frontend dependencies (npm install)"
    ( cd "$FRONTEND_DIR" && npm install --no-audit --no-fund )
  fi
  if [[ "$FORCE_REBUILD" -eq 1 ]]; then
    log "building frontend (--rebuild)"
    ( cd "$FRONTEND_DIR" && npm run build )
    record_frontend_git_state
  elif frontend_is_stale; then
    log "building frontend (sources, config, or git commit/branch changed since last build)"
    ( cd "$FRONTEND_DIR" && npm run build )
    record_frontend_git_state
  else
    log "frontend already up to date (skipping build; use --rebuild to force)"
  fi
}

split_bind() {
  # Populates HOST and PORT from BIND (IP:PORT).
  [[ "$BIND" == *:* ]] || die "--bind must be IP:PORT (got '$BIND')"
  HOST="${BIND%:*}"
  PORT="${BIND##*:}"
  [[ -n "$HOST" && -n "$PORT" ]] || die "--bind must be IP:PORT (got '$BIND')"
  [[ "$PORT" =~ ^[0-9]+$ ]] || die "port must be numeric (got '$PORT')"
}

# Warn when the checked-out code advanced since the last start. Schema
# migrations run automatically and are additive/idempotent (see backend
# init_db), but there is no schema-version marker, so this is a code-delta
# heuristic: it flags that an update happened and that destructive schema or
# dependency changes (if any) may need manual follow-up. Records the current
# HEAD for next time. Never fails the script.
warn_on_update() {
  local current previous
  current="$(git_head)"
  [[ -z "$current" ]] && return 0   # not a git checkout; nothing to compare
  mkdir -p "$PID_DIR"
  if [[ -f "$COMMIT_STAMP" ]]; then
    previous="$(cat "$COMMIT_STAMP" 2>/dev/null || true)"
    if [[ -n "$previous" && "$previous" != "$current" ]]; then
      log "code updated ${previous}..${current} since the last start."
      log "  - the database migrates automatically on start (additive, idempotent)."
      log "  - no automatic data/app.db reset is performed; if this update includes a"
      log "    destructive schema change or a dependency change, review the release"
      log "    notes for any manual steps."
    fi
  fi
  printf '%s\n' "$current" >"$COMMIT_STAMP" 2>/dev/null || true
}

# Surface security-relevant conditions the background server only writes to the
# log file (the operator running `start` would otherwise never see them).
warn_runtime_state() {
  if [[ "${APP_ENABLE_AUTH:-1}" == "0" ]]; then
    err "authentication is DISABLED (APP_ENABLE_AUTH=0); the API is unauthenticated."
  fi
  # The data dir (and thus the credentials file) honours APP_DATA_DIR.
  local data_dir="${APP_DATA_DIR:-$PROJECT_DIR/data}"
  local creds="$data_dir/first-run-admin-credentials.txt"
  if [[ -f "$creds" ]]; then
    log "first-run administrator credentials are present at:"
    log "    $creds"
    log "  change the password at first login, then delete this file."
  fi
}

health_host() {
  # 0.0.0.0 is not directly connectable; probe via loopback.
  if [[ "$HOST" == "0.0.0.0" || "$HOST" == "::" ]]; then
    echo "127.0.0.1"
  else
    echo "$HOST"
  fi
}

server_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

cmd_start() {
  if server_running; then
    log "already running (pid $(cat "$PID_FILE"))"
    return 0
  fi
  mkdir -p "$PID_DIR" "$LOG_DIR"
  warn_on_update
  ensure_venv
  ensure_frontend
  split_bind

  export APP_BASE_PREFIX="$BASE_PREFIX"
  export APP_LOG_DIR="$LOG_DIR"
  : "${APP_ENABLE_AUTH:=1}"
  export APP_ENABLE_AUTH

  if [[ "$DEV_MODE" -eq 1 ]]; then
    # Foreground development mode: auto-reload enabled, output streams to the
    # console and is still written to "$LOG_FILE" by the application's own
    # logging. No PID file is used; stop with Ctrl-C.
    export APP_DEV=1
    warn_runtime_state
    log "starting server in foreground (dev) on $HOST:$PORT (base-prefix='${BASE_PREFIX:-/}')"
    log "auto-reload enabled; logs also at $LOG_FILE; press Ctrl-C to stop"
    cd "$BACKEND_DIR"
    exec "$VENV_PY" -m uvicorn app.main:app \
      --host "$HOST" --port "$PORT" --reload
  fi

  log "starting server on $HOST:$PORT (base-prefix='${BASE_PREFIX:-/}')"
  # Background mode: the application owns "$LOG_FILE" through its file handler, so
  # the process's stdout/stderr are discarded to avoid duplicate lines. If the
  # process dies before logging initializes, re-run with --dev for live output.
  (
    cd "$BACKEND_DIR"
    exec "$VENV_PY" -m uvicorn app.main:app --host "$HOST" --port "$PORT"
  ) >/dev/null 2>&1 &
  local pid=$!
  echo "$pid" >"$PID_FILE"

  # Give uvicorn a moment, then verify it is alive and healthy.
  sleep 2
  if ! kill -0 "$pid" >/dev/null 2>&1; then
    rm -f "$PID_FILE"
    err "server failed to start; recent log ($LOG_FILE):"
    tail -n 20 "$LOG_FILE" >&2 2>/dev/null || true
    err "for live diagnostics, run: $(basename "$0") start --dev"
    exit 1
  fi
  if command -v curl >/dev/null 2>&1; then
    local hhost
    hhost="$(health_host)"
    if curl -fsS "http://$hhost:$PORT/api/health" >/dev/null 2>&1; then
      log "healthy at http://$hhost:$PORT${BASE_PREFIX}/"
    else
      log "started (pid $pid); health check not yet responding — see $LOG_FILE"
    fi
  else
    log "started (pid $pid)"
  fi
  # Surface security-relevant startup conditions the background server only
  # wrote to the log file (run after startup so first-run creds exist).
  warn_runtime_state
}

cmd_stop() {
  if ! server_running; then
    log "not running"
    rm -f "$PID_FILE"
    return 0
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  log "stopping server (pid $pid)"
  kill "$pid" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" >/dev/null 2>&1 || break
    sleep 0.25
  done
  if kill -0 "$pid" >/dev/null 2>&1; then
    log "forcing stop"
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$PID_FILE"
  log "stopped"
}

cmd_status() {
  if server_running; then
    log "running (pid $(cat "$PID_FILE")); log: $LOG_FILE"
    return 0
  fi
  log "not running"
  return 3
}

cmd_reset_admin_password() {
  ensure_venv
  ( cd "$BACKEND_DIR" && exec "$VENV_PY" -m app.admin reset-admin-password )
}

usage() {
  cat <<'EOF'
appmanager-lite — lifecycle manager for the AppManager Lite portal.

Usage:
  appmanager-lite install   (root/sudo required)
  appmanager-lite start   [--bind IP:PORT] [--base-prefix /path] [--dev] [--rebuild] [--reinstall]
  appmanager-lite stop
  appmanager-lite status
  appmanager-lite restart [--bind IP:PORT] [--base-prefix /path]
  appmanager-lite reset-admin-password
  appmanager-lite --reset-admin-password

Commands:
  install              Install the minimal prerequisites: uv (for the invoking
                       user, via the official installer) and Node.js/npm (via the
                       OS package manager). Requires root — run with sudo from
                       your normal account (e.g. `sudo ./appmanager-lite install`),
                       so uv installs into that user's home. The portal itself
                       runs as a normal user.

Options:
  --bind IP:PORT       Address to bind (default 127.0.0.1:8000).
  --base-prefix /path  Serve under a subpath behind a reverse proxy (e.g. /home).
  --dev                Run in the foreground with auto-reload; Ctrl-C to stop.
  --rebuild            Force a frontend rebuild even when it looks up to date.
  --reinstall          Reinstall backend dependencies (uv sync --reinstall).

Prerequisites: uv, Node.js with npm, and Python 3.11+. Install uv and Node/npm
with `sudo ./appmanager-lite install` (root only), or install them manually.

On start/restart the script rebuilds the frontend automatically when its
sources, config, or the current commit changed since the last build, refreshes
frontend dependencies when the lockfile changed, and runs uv sync for the
backend (uv is the only Python dependency manager). It also warns when the
checked-out code advanced since the last start: the database migrates
automatically on start (additive), but destructive schema or dependency changes
may need manual follow-up.

Logs are written to logs/app.log. The server runs locally by default; for
deployment behind a reverse proxy that serves from a subpath, pass --base-prefix
and bind to 0.0.0.0 (e.g. --bind 0.0.0.0:8000 --base-prefix /home).
EOF
}

main() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  # A bare --reset-admin-password flag is accepted as a command alias.
  if [[ "$command" == "--reset-admin-password" ]]; then
    command="reset-admin-password"
  fi
  # A bare --install flag is accepted as a command alias for `install`.
  if [[ "$command" == "--install" ]]; then
    command="install"
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bind)        BIND="${2:?--bind requires IP:PORT}"; shift 2 ;;
      --bind=*)      BIND="${1#*=}"; shift ;;
      --base-prefix) BASE_PREFIX="${2:?--base-prefix requires a value}"; shift 2 ;;
      --base-prefix=*) BASE_PREFIX="${1#*=}"; shift ;;
      --dev)         DEV_MODE=1; shift ;;
      --rebuild)     FORCE_REBUILD=1; shift ;;
      --reinstall)   FORCE_REINSTALL=1; shift ;;
      --reset-admin-password) command="reset-admin-password"; shift ;;
      --install)     command="install"; shift ;;
      -h|--help)     usage; exit 0 ;;
      *)             die "unknown option: $1" ;;
    esac
  done

  # Normalize an empty or "/" prefix to "" (root).
  [[ "$BASE_PREFIX" == "/" ]] && BASE_PREFIX=""

  case "$command" in
    install)              cmd_install ;;
    start)                cmd_start ;;
    stop)                 cmd_stop ;;
    status)               cmd_status ;;
    restart)              cmd_stop; cmd_start ;;
    reset-admin-password) cmd_reset_admin_password ;;
    ""|-h|--help|help)    usage ;;
    *)                    die "unknown command: $command (try --help)" ;;
  esac
}

main "$@"
